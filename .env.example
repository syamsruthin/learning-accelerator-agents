# .env
# Environment variables for the Learning Accelerator.
# Copy this file: cp .env.example .env
# Then fill in your values.

# ── Model configuration (OpenRouter) ──────────────────────────────────────
# All LLM calls go through OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional per-agent model overrides. Leave empty to use the defaults in
# src/llm.py (reasoning for each default: claude-reasoning/).
# default: anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_PLANNER=
# default: anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_EXPLAINER=
# default: anthropic/claude-haiku-5.5
OPENROUTER_MODEL_QUIZ=
# default: openai/gpt-6-luna
OPENROUTER_MODEL_GRADER=
# default: anthropic/claude-haiku-5.5
OPENROUTER_MODEL_COACH=
# default: google/gemini-3.8-flash
OPENROUTER_MODEL_STUDY_BUDDY=
# default: openai/gpt-6-sol
OPENROUTER_MODEL_EVAL_JUDGE=

# ── Storage ───────────────────────────────────────────────────────────────────
CHECKPOINT_DB=data/checkpoints.db
NOTES_PATH=study_materials/sample_notes

# ── Langfuse observability ────────────────────────────────────────────────────
# Get keys from http://localhost:3000 after running: docker compose up -d
# Leave empty to run without observability (the system still works).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── A2A service URLs ──────────────────────────────────────────────────────────
QUIZ_SERVICE_URL=http://localhost:9001
STUDY_BUDDY_URL=http://localhost:9002

# ── A2A feature toggles ───────────────────────────────────────────────────────
# Set to "false" to use local quiz generation instead of the A2A service.
# Useful when running main.py without starting the A2A services first.
USE_A2A_QUIZ=true

# Set to "false" to skip CrewAI Study Buddy calls when scores are low.
USE_STUDY_BUDDY=true

# ── LLM token usage logging ───────────────────────────────────────────────
# Every LLM call logs input/output tokens to the console and appends a JSON
# line here. Set to empty to disable the file.
LLM_USAGE_LOG_FILE=data/llm_usage.jsonl
# INFO shows one line per call; WARNING shows only failed calls
LLM_USAGE_LOG_LEVEL=INFO
